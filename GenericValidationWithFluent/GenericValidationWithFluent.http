@GenericValidationWithFluent_HostAddress = http://localhost:5167

GET {{GenericValidationWithFluent_HostAddress}}/weatherforecast/
Accept: application/json

###

# ============================================
# AutoMapper Examples
# ============================================

# Get All Products (maps to ProductListItemDTO)
GET {{GenericValidationWithFluent_HostAddress}}/products/
Accept: application/json

###

# Get Single Product (maps to ProductResponseDTO with nested Category)
GET {{GenericValidationWithFluent_HostAddress}}/products/1
Accept: application/json

###

# Create Product (CreateProductDTO -> Product -> ProductResponseDTO)
POST {{GenericValidationWithFluent_HostAddress}}/products/
Content-Type: application/json

{
  "name": "Laptop",
  "description": "High performance laptop",
  "price": 999.99,
  "quantity": 10
}

###

# Update Product (UpdateProductDTO -> Product -> ProductResponseDTO)
PUT {{GenericValidationWithFluent_HostAddress}}/products/
Content-Type: application/json

{
  "id": 1,
  "name": "Updated Laptop",
  "description": "Updated high performance laptop with SSD",
  "price": 1299.99,
  "quantity": 5
}

###

# ============================================
# Keyed Services Examples
# ============================================

# Test Notification via Email (Keyed Service: "email")
POST {{GenericValidationWithFluent_HostAddress}}/products/1/notify?channel=email
Accept: application/json

###

# Test Notification via SMS (Keyed Service: "sms")
POST {{GenericValidationWithFluent_HostAddress}}/products/1/notify?channel=sms
Accept: application/json

###

# Test Notification via Push (Keyed Service: "push")
POST {{GenericValidationWithFluent_HostAddress}}/products/1/notify?channel=push
Accept: application/json

###

# Test Invalid Channel
POST {{GenericValidationWithFluent_HostAddress}}/products/1/notify?channel=invalid
Accept: application/json

###

# ============================================
# Validation Examples
# ============================================

# Validation Error - Empty fields
POST {{GenericValidationWithFluent_HostAddress}}/products/
Content-Type: application/json

{
  "name": "",
  "description": "",
  "price": -10,
  "quantity": -5
}

###

# Validation Error - Name too long
POST {{GenericValidationWithFluent_HostAddress}}/products/
Content-Type: application/json

{
  "name": "This is a very long product name that exceeds the maximum length of 100 characters allowed by the validator rule",
  "description": "Valid description",
  "price": 50,
  "quantity": 5
}

###

PUT {{GenericValidationWithFluent_HostAddress}}/products/
Content-Type: application/json

{
  "id": 1,
  "name": "Updated Laptop",
  "description": "Updated high performance laptop",
  "price": 1299.99,
  "quantity": 5
}

